# Copy to .env. Nothing here has a usable default — config.py fails loudly instead of
# quietly running with a fake secret.

ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://kaarigar:kaarigar@localhost:5432/kaarigar
REDIS_URL=redis://localhost:6379/0
AI_BASE_URL=http://localhost:8001

# openssl rand -hex 32
JWT_SECRET=

# 🔒 Wraps the only third-party credentials we ever hold — Amazon/Flipkart OAuth refresh
# tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Object storage. S3 API — Supabase Storage in production, MinIO locally. On Supabase, do
# not fill this in by hand: `python3 bootstrap_supabase.py <ref>` writes every S3_* value
# below and creates both buckets, from one personal access token.
#
# TWO buckets, and that is a privacy boundary rather than tidiness. Public-read is a
# property of the BUCKET, so a raw/ prefix inside a public bucket is readable by anyone
# holding the URL — which is exactly what check_storage.py caught the first time:
#   S3_BUCKET      PUBLIC.  public/... the thumb/display variants a marketplace page loads.
#   S3_RAW_BUCKET  PRIVATE. raw/...    the artisan's original frame, read only by us.
#
# S3_ACCESS_KEY/S3_SECRET_KEY are either a generated S3 key pair (dashboard: Project
# Settings -> Storage -> S3 connection) or Supabase's session-token form, which is what the
# bootstrap uses because no API mints key pairs: access key = project ref, secret = anon
# key, S3_SESSION_TOKEN = service_role JWT. Leave S3_SESSION_TOKEN empty for MinIO.
#
# Unset is a supported dev state: /uploads/{id}/complete answers 503 and says why, rather
# than writing a URL that points at nothing (which is what it used to do).

# Where uploaded chunks are assembled. Defaults to web/api/.storage — the AI service opens
# the file:// url that /uploads/{id}/complete returns, so in dev both must see this path.
# This is the RAW landing spot and is independent of S3 below: with no S3 configured the
# file:// url stands, which is what makes the image pipeline testable on one machine.
STORAGE_DIR=

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kaarigar
S3_RAW_BUCKET=kaarigar-raw
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=

# Sarvam AI. Tried BEFORE Bhashini: one REST call with one key, where Bhashini needs a
# pipeline-config round trip first. With neither set, /api/asr and /api/tts answer 503 and
# the cataloger falls back to typing — which for a user who cannot read is the app not
# working. This is the key to set first.
#   https://dashboard.sarvam.ai -> API Keys
SARVAM_API_KEY=

# bhashini.gov.in / ULCA portal -> My Profile -> Generate API key
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Tier B. Absent in dev; adapters report needs_connect rather than failing.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=

# ONDC. We register ONCE as a Marketplace Seller Node; artisans are sub-sellers under this
# subscriber id and never register themselves. Separate key pairs for signing and
# encryption — do not reuse one for both.
ONDC_SUBSCRIBER_ID=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=
ONDC_REGISTRY_URL=https://staging.registry.ondc.org

# --- Supabase -----------------------------------------------------------------
# Runtime = TRANSACTION pooler (6543). db.py disables prepared statements and uses
# NullPool for this host, because pgbouncer transaction mode breaks both.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Migrations = SESSION pooler (5432). Alembic takes advisory locks and runs long DDL
# transactions; neither survives transaction-mode pooling.
# DATABASE_MIGRATION_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
