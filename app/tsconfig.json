{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Five files stay .js on purpose and are NOT type-checked:
    //   api/policy.js, camera/gate.js, voice/micLifecycle.js, voice/engine.js,
    //   screens/homeTodos.js
    // Each carries a self-check that runs under bare `node`, which cannot import a .ts
    // module — see CLAUDE.md's testing section. `checkJs` stays off so those five are
    // compiled but not analysed; everything else in src/ is .ts or .tsx and fully strict.
    "allowJs": true,
    "checkJs": false,

    // No `baseUrl`: TypeScript 7 removed it. Paths are resolved relative to this
    // file, so the mapping is written out in full and vite.config.ts carries the
    // matching alias. The two must agree or a shadcn-generated import resolves
    // in the editor and fails in the bundler.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
