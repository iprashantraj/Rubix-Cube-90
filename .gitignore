__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.env
.env.local
.env.bak
# Supabase personal access token. Full control of every project in the account — a wider
# credential than anything in .env, and it is only here long enough to bootstrap.
.supabase-token
.DS_Store
research/data/

# Dev databases. NOT just build noise — a working dev.db holds real artisan rows: phone
# numbers, names and consent artifacts from whoever last tested on a device. Committing one
# publishes personal data and contradicts the privacy rules in docs/ and app/README.md.
# Recreate an empty one with api.db.create_all() (see web/README.md); never commit it.
*.db
*.sqlite
*.sqlite3

# Server-side TTS clip cache. Regenerated on demand, and it is bought audio, not source.
web/api/.cache/

# Assembled uploads. Real artisan photographs — the same privacy argument as the dev
# database two blocks up, and the default location for STORAGE_DIR.
web/api/.storage/
*.pt
*.pth
*.onnx

# build output
dist/
.next/
out/

# NOT android/ wholesale. `app/android/` is a Capacitor project, and two files in it are
# hand-written rather than generated:
#   res/xml/network_security_config.xml   cleartext for loopback, for `adb reverse`
#   AndroidManifest.xml                   that config + camera/mic/vibrate permissions
# Ignoring the whole folder means a rebuilt native project silently loses both, and the
# symptom is the app reporting "no network" on a phone with full signal — the exact failure
# app/src/api/client.js warns about, arriving from a completely different direction.
# So: keep the project. app/android/.gitignore (Capacitor's own, from the Android template)
# already excludes everything Gradle regenerates — 512K of source is tracked, not 84M.
ios/
*.tsbuildinfo
next-env.d.ts

# Calibration fixtures. The manifest is committed, the pixels are not — same rule
# as research/data/. See images/README.md.
images/raw/*
images/out/*
!images/raw/.gitkeep
!images/out/.gitkeep
ai/.venv/

# research/segmentation/out/ — the benchmark's per-image dumps. Five models x 41
# fixtures of alpha mattes and cut-outs is ~250MB of binary, regenerable from
# bench.py in about twenty minutes. Same reasoning as images/out/ above.
#
# The six contact sheets and the two metrics tables stay tracked: they are the
# evidence RESULTS.md argues from, and a verdict whose evidence has to be
# regenerated before anyone can check it is not much of a verdict. ~9.6MB total.
# NB: line 32's blanket `out/` ignores the directory itself, and git will not look
# inside an ignored directory — so the negations below only work if the directory is
# un-ignored first. Order matters here.
!research/segmentation/out/
research/segmentation/out/*
!research/segmentation/out/sheet-*.png
!research/segmentation/out/metrics.csv
!research/segmentation/out/consolidated.csv
!research/segmentation/out/run.json
# the upscale follow-up: keep its two small tables, drop the 3MB 100% panels
!research/segmentation/out/upscale/
research/segmentation/out/upscale/*
!research/segmentation/out/upscale/*.csv
